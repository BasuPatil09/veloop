PORT=5000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=veloop_dev
DB_USER=veloop
DB_PASSWORD=replace-with-your-mysql-password
# Set to true for managed hosts (Aiven, PlanetScale, etc.) — they require TLS and
# reject plain connections. Leave false for local MySQL/MariaDB.
DB_SSL=false

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_SECRET=replace-with-a-different-long-random-string
REFRESH_EXPIRES_IN=7d

# CORS — must match the frontend origin exactly
CLIENT_URL=http://localhost:5173

# Cookies
COOKIE_SECRET=replace-with-a-long-random-string

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security
BCRYPT_SALT_ROUNDS=12
