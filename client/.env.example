# Local dev: the client and server run on different ports, so this needs the full URL.
VITE_API_BASE_URL=http://localhost:5000/api

# Single-Vercel-project deployment (see DEPLOYMENT.md): frontend and API are served
# from the SAME domain, so this should be a relative path instead:
# VITE_API_BASE_URL=/api

# Dev-only fallback to mock data if the backend is unreachable. Must never be true in a production build.
VITE_ENABLE_MOCK_FALLBACK=false
